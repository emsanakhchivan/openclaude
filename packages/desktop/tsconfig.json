{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "outDir": "./out",
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@gitlawb/openclaude/sdk": ["../../src/entrypoints/sdk.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "out", "release"]
}
